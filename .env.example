DEV_LIMAN_DB_USER=root
DEV_LIMAN_DB_PASSWORD=rootpassword
DEV_LIMAN_DB_NAME=columbDB

# Telegram Alert Bot & Webhook Monitoring (TASK-15)
TELEGRAM_BOT_TOKEN=
