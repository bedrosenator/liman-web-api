# ==============================================================================
# Liman Web API — Production Environment Config (.env)
# Скопируйте этот файл в .env на сервере Hetzner в директории проекта:
# cp .env.production.example .env
# ==============================================================================

NODE_ENV=production
PORT=3000

# Мастер-ключ для авторизации администратора в API
MASTER_API_KEY=liman-master-key-prod-change-me

# Локальный порт Nginx для проксирования через Caddy (по умолчанию 8088)
LIMAN_HTTP_PORT=8088

# Master Database PostgreSQL
POSTGRES_DB=liman_master
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Telegram Alert Bot (для уведомлений об ошибках и критических событиях)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
